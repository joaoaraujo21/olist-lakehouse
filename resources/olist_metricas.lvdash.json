{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs oficiais (sem recorte)",
      "queryLines": [
        "SELECT MEASURE(gmv) AS gmv, MEASURE(pedidos_validos) AS pedidos_validos, MEASURE(ticket_medio) AS ticket_medio,\n",
        "       MEASURE(taxa_cancelamento) AS taxa_cancelamento, MEASURE(pct_entregas_no_prazo) AS pct_no_prazo,\n",
        "       MEASURE(lead_time_mediana_dias) AS lead_time_mediana, MEASURE(lead_time_medio_dias) AS lead_time_medio,\n",
        "       MEASURE(review_score_medio) AS review_medio, MEASURE(taxa_recompra) AS taxa_recompra\n",
        "FROM olist.gold.mv_pedidos\n"
      ]
    },
    {
      "name": "ds_concentracao",
      "displayName": "Concentração de vendas",
      "queryLines": [
        "SELECT MEASURE(concentracao_top10) AS concentracao_top10 FROM olist.gold.mv_concentracao\n"
      ]
    },
    {
      "name": "ds_mensal",
      "displayName": "KPIs por mês da compra",
      "queryLines": [
        "SELECT to_date(concat(ano_mes, '-01')) AS mes, MEASURE(gmv) AS gmv, MEASURE(pedidos_validos) AS pedidos_validos,\n",
        "       MEASURE(taxa_cancelamento) AS taxa_cancelamento, MEASURE(pct_entregas_no_prazo) AS pct_no_prazo,\n",
        "       MEASURE(review_score_medio) AS review_medio\n",
        "FROM olist.gold.mv_pedidos GROUP BY ano_mes ORDER BY ano_mes\n"
      ]
    },
    {
      "name": "ds_uf",
      "displayName": "GMV por UF do cliente",
      "queryLines": [
        "SELECT uf_cliente, MEASURE(gmv) AS gmv FROM olist.gold.mv_pedidos GROUP BY uf_cliente ORDER BY gmv DESC LIMIT 10\n"
      ]
    },
    {
      "name": "ds_categoria",
      "displayName": "GMV por categoria",
      "queryLines": [
        "SELECT categoria, MEASURE(gmv) AS gmv FROM olist.gold.mv_itens GROUP BY categoria ORDER BY gmv DESC LIMIT 15\n"
      ]
    },
    {
      "name": "ds_atraso",
      "displayName": "Atraso x review",
      "queryLines": [
        "SELECT faixa_atraso, pedidos, review_score_medio, pct_nota_1_ou_2 FROM olist.gold.gold_atraso_vs_review ORDER BY faixa_atraso\n"
      ]
    },
    {
      "name": "ds_sla_uf",
      "displayName": "Entrega no prazo por UF",
      "queryLines": [
        "SELECT uf_cliente, sum(entregues_no_prazo) / sum(pedidos_entregues) AS pct_no_prazo, sum(pedidos_entregues) AS entregues\n",
        "FROM olist.gold.gold_delivery_sla GROUP BY uf_cliente ORDER BY pct_no_prazo\n"
      ]
    },
    {
      "name": "ds_scorecard",
      "displayName": "Scorecard de vendedores",
      "queryLines": [
        "SELECT seller_id, seller_city, seller_state, valido_de, valido_ate, pedidos, itens, gmv,\n",
        "       taxa_cancelamento, pct_entregas_no_prazo, review_score_medio\n",
        "FROM olist.gold.gold_seller_scorecard ORDER BY gmv DESC LIMIT 1000\n"
      ]
    },
    {
      "name": "ds_mudaram",
      "displayName": "Vendedores que mudaram de endereço",
      "queryLines": [
        "SELECT seller_id, seller_city, seller_state, valido_de, valido_ate, itens, gmv\n",
        "FROM olist.gold.gold_seller_scorecard\n",
        "WHERE seller_id IN (SELECT seller_id FROM olist.gold.dim_seller GROUP BY seller_id HAVING count(*) > 1)\n",
        "ORDER BY seller_id, valido_de LIMIT 300\n"
      ]
    }
  ],
